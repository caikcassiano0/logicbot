{
	// >>> AJUSTE ESTE CAMINHO para o executável da Godot 4.7.x no seu computador <<<
	// Windows: "C:/Godot/Godot_v4.7.2-stable_win64.exe"
	// Linux:   "/home/seu_usuario/Godot/Godot_v4.7.2-stable_linux.x86_64"
	"godotTools.editorPath.godot4": "C:/Godot/Godot_v4.7.2-stable_win64.exe",

	"files.exclude": {
		"**/.godot": true,
		"**/*.uid": true
	},
	"files.associations": {
		"*.por": "plaintext",
		"*.gdshader": "gdshader"
	},
	"[gdscript]": {
		"editor.insertSpaces": false,
		"editor.tabSize": 4,
		"editor.detectIndentation": false
	},
	"files.encoding": "utf8",
	"files.eol": "\n"
}
